<%- include('../../partials/header', { pageTitle: pageTitle }) %>
<%- include('../../partials/sidebar', { activePage: 'computers' }) %>

<div class="w-full max-w-7xl">

    <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold mb-3">
            Data Komputer
        </h1>
        <p class="text-gray-400">
            Daftar inventaris dan status PC warnet.
        </p>
    </div>

    <a href="/computers/tambah"
        class="inline-block bg-blue-600 hover:bg-blue-500 py-3 px-5 rounded-xl transition my-5">
        + Tambah Komputer
    </a>

    <div class="overflow-x-auto border border-white/10 shadow-2xl bg-white/5 backdrop-blur-md my-4 rounded-xl">

        <table class="w-full text-sm text-left">

            <thead class="bg-white/10 text-gray-200 uppercase text-xs">
                <tr>
                    <th class="px-4 py-4 text-center">No</th>
                    <th class="px-6 py-4 text-center">Nomor PC</th>
                    <th class="px-6 py-4 text-center">Jenis PC</th>
                    <th class="px-6 py-4">Spesifikasi</th>
                    <th class="px-6 py-4 text-center">Status</th>
                    <th class="px-6 py-4 text-center">Aksi</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-white/10">

                <% const computerList = typeof computers !== 'undefined' ? computers : [] %>

                <% if (computerList.length === 0) { %>

                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-400">
                            Belum ada data komputer.
                        </td>
                    </tr>

                <% } else { %>

                    <% computerList.forEach((item, index) => { %>

                        <tr class="hover:bg-white/10 transition">

                            <td class="px-4 py-5 text-center text-gray-400">
                                <%= index + 1 %>
                            </td>

                            <td class="px-6 py-5 text-center font-semibold">
                                <span class="bg-blue-600/30 text-blue-300 border border-blue-500/30 px-3 py-1 rounded-full text-xs font-bold">
                                    PC <%= item.nomor_pc %>
                                </span>
                            </td>

                            <td class="px-6 py-5 text-center">
                                <% if (item.jenis_pc === 'Premium') { %>
                                    <span class="bg-purple-600/30 text-purple-300 border border-purple-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        Premium
                                    </span>
                                <% } else if (item.jenis_pc === 'VIP') { %>
                                    <span class="bg-amber-600/30 text-amber-300 border border-amber-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        VIP
                                    </span>
                                <% } else { %>
                                    <span class="bg-gray-600/30 text-gray-300 border border-gray-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        Reguler
                                    </span>
                                <% } %>
                            </td>

                            <td class="px-6 py-5 text-gray-300">
                                <%= item.spesifikasi || '-' %>
                            </td>

                            <td class="px-6 py-5 text-center">
                                <% if (item.status === 'Tersedia') { %>
                                    <span class="bg-green-500/20 text-green-400 border border-green-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        Tersedia
                                    </span>
                                <% } else if (item.status === 'Digunakan') { %>
                                    <span class="bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        Digunakan
                                    </span>
                                <% } else { %>
                                    <span class="bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        Maintenance
                                    </span>
                                <% } %>
                            </td>

                            <td class="px-6 py-5">
                                <div class="flex items-center justify-center gap-2">

                                    <a href="/computers/edit/<%= item.id_computer %>"
                                        class="bg-blue-500 hover:bg-blue-400 py-2 px-4 rounded transition">
                                        Edit
                                    </a>

                                    <form action="/computers/delete/<%= item.id_computer %>"
                                        method="POST"
                                        onsubmit="return confirm('Yakin ingin menghapus komputer ini?')">

                                        <button type="submit"
                                            class="bg-red-500 hover:bg-red-400 py-2 px-4 rounded transition">
                                            Delete
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>

                    <% }) %>

                <% } %>

            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/footer') %>