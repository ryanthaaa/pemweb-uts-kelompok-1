<%- include('../../partials/header', { pageTitle: pageTitle }) %>
<%- include('../../partials/sidebar', { activePage: 'produk' }) %>

<div class="w-full max-w-7xl">

    <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold mb-3">
            Data Produk
        </h1>
        <p class="text-gray-400">
            Daftar inventaris produk makanan, minuman, dan barang warnet.
        </p>
    </div>

    <a href="/products/tambah"
        class="inline-block bg-blue-600 hover:bg-blue-500 py-3 px-5 rounded-xl transition my-5">
        + Tambah Produk
    </a>

    <div class="overflow-x-auto border border-white/10 shadow-2xl bg-white/5 backdrop-blur-md my-4 rounded-xl">

        <table class="w-full text-sm text-left">

            <thead class="bg-white/10 text-gray-200 uppercase text-xs">
                <tr>
                    <th class="px-4 py-4 text-center">No</th>
                    <th class="px-6 py-4">Nama Produk</th>
                    <th class="px-6 py-4 text-center">Kategori</th>
                    <th class="px-6 py-4 text-center">Harga</th>
                    <th class="px-6 py-4 text-center">Stok</th>
                    <th class="px-6 py-4 text-center">Aksi</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-white/10">

                <% 
                    const productList = (typeof produkList !== 'undefined' && produkList) 
                        ? produkList 
                        : ((typeof products !== 'undefined' && products) ? products : []); 
                %>

                <% if (productList.length === 0) { %>

                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-400">
                            Belum ada data produk.
                        </td>
                    </tr>

                <% } else { %>

                    <% productList.forEach((item, index) => { %>

                        <tr class="hover:bg-white/10 transition">

                            <td class="px-4 py-5 text-center text-gray-400">
                                <%= index + 1 %>
                            </td>

                            <td class="px-6 py-5 font-semibold text-white">
                                <%= item.nama_produk %>
                            </td>

                            <td class="px-6 py-5 text-center">
                                <% if (item.kategori === 'Makanan') { %>
                                    <span class="bg-orange-500/20 text-orange-400 border border-orange-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        Makanan
                                    </span>
                                <% } else if (item.kategori === 'Minuman') { %>
                                    <span class="bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        Minuman
                                    </span>
                                <% } else { %>
                                    <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-full text-xs font-medium">
                                        <%= item.kategori || 'Cemilan' %>
                                    </span>
                                <% } %>
                            </td>

                            <td class="px-6 py-5 text-center font-bold text-green-400">
                                Rp <%= Number(item.harga || 0).toLocaleString('id-ID') %>
                            </td>

                            <td class="px-6 py-5 text-center">
                                <% if (item.stok <= 5) { %>
                                    <span class="text-red-400 font-bold bg-red-500/10 px-3 py-1 rounded-full border border-red-500/20">
                                        <%= item.stok %>
                                    </span>
                                <% } else { %>
                                    <span class="text-gray-300">
                                        <%= item.stok %>
                                    </span>
                                <% } %>
                            </td>

                            <td class="px-6 py-5">
                                <div class="flex items-center justify-center gap-2">

                                    <a href="/products/edit/<%= item.id_produk %>"
                                        class="bg-blue-500 hover:bg-blue-400 py-2 px-4 rounded transition">
                                        Edit
                                    </a>

                                    <form action="/products/delete/<%= item.id_produk %>"
                                        method="POST"
                                        onsubmit="return confirm('Yakin ingin menghapus produk ini?')">

                                        <button type="submit"
                                            class="bg-red-500 hover:bg-red-400 py-2 px-4 rounded transition">
                                            Delete
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>

                    <% }) %>

                <% } %>

            </tbody>
        </table>
    </div>
</div>

<%- include('../../partials/footer') %>