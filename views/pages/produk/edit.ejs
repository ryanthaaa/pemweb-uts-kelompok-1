<%- include('../../partials/header', { pageTitle: pageTitle }) %>
<%- include('../../partials/sidebar', { activePage: 'produk' }) %>

<% const item = (typeof produk !== 'undefined' && produk) ? produk : product; %>

<div class="w-full max-w-3xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-bold mb-3">Edit Produk</h1>
        <p class="text-gray-400">Perbarui informasi stok dan harga produk.</p>
    </div>

    <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-2xl p-6 md:p-8">
        <form action="/products/edit/<%= item.id_produk %>" method="POST" class="space-y-5">

            <!-- Nama Produk -->
            <div>
                <label for="nama_produk" class="block text-sm font-medium text-gray-300 mb-2">
                    Nama Produk <span class="text-red-400">*</span>
                </label>
                <input
                    type="text"
                    name="nama_produk"
                    id="nama_produk"
                    value="<%= item.nama_produk %>"
                    required
                    placeholder="Contoh: Indomie Goreng + Telur"
                    class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-blue-400"
                >
            </div>

            <!-- Kategori -->
            <div>
                <label for="kategori" class="block text-sm font-medium text-gray-300 mb-2">
                    Kategori <span class="text-red-400">*</span>
                </label>
                <select
                    name="kategori"
                    id="kategori"
                    required
                    class="w-full px-4 py-3 rounded-lg bg-[#09132d] border border-white/10 text-white focus:outline-none focus:border-blue-400"
                >
                    <option value="Makanan" <%= item.kategori === 'Makanan' ? 'selected' : '' %>>Makanan</option>
                    <option value="Minuman" <%= item.kategori === 'Minuman' ? 'selected' : '' %>>Minuman</option>
                    <option value="Cemilan" <%= item.kategori === 'Cemilan' ? 'selected' : '' %>>Cemilan</option>
                </select>
            </div>

            <!-- Harga -->
            <div>
                <label for="harga" class="block text-sm font-medium text-gray-300 mb-2">
                    Harga (Rp) <span class="text-red-400">*</span>
                </label>
                <input
                    type="number"
                    name="harga"
                    id="harga"
                    min="0"
                    value="<%= item.harga %>"
                    required
                    placeholder="Contoh: 12000"
                    class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-blue-400"
                >
            </div>

            <!-- Stok -->
            <div>
                <label for="stok" class="block text-sm font-medium text-gray-300 mb-2">
                    Stok <span class="text-red-400">*</span>
                </label>
                <input
                    type="number"
                    name="stok"
                    id="stok"
                    min="0"
                    value="<%= item.stok %>"
                    required
                    placeholder="Contoh: 50"
                    class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-blue-400"
                >
            </div>

            <!-- Tombol -->
            <div class="flex justify-end gap-3 border-t border-white/10 pt-6">
                <a
                    href="/products"
                    class="px-5 py-3 rounded-lg bg-white/10 text-gray-300 hover:bg-white/20 transition"
                >
                    Batal
                </a>
                <button
                    type="submit"
                    class="px-5 py-3 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition"
                >
                    Perbarui Produk
                </button>
            </div>

        </form>
    </div>
</div>

<%- include('../../partials/footer') %>